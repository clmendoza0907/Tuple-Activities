colors = ("red", "green", "blue")
print(colors[0])   # red   → first item
print(colors[-1])  # blue  → last item

numbers = (10, 20, 30, 40, 50)
print(numbers[1:4])
# Output: (20, 30, 40)
nums = (1, 2, 2, 3, 2)

# Count how many times 2 appears
print(nums.count(2))   # 3
# Find index of 3
print(nums.index(3))   # 3

point = (5, 10)
x, y = point          # unpacking
print(f"x = {x}, y = {y}")
# Output: x = 5, y = 10
t1 = (1, 2)
t2 = (3, 4)
combined = (t1 + t2) * 2
print(combined)
# Output: (1, 2, 3, 4, 1, 2, 3, 4)

